# LOCAL SETUP STEPS:
# 1. Create a local Postgres database.
# 2. Rename this file to .env
# 3. Update DATABASE_URL with your local connection string.
# 4. Run `npm run db:push` to create tables.

# DATABASE_URL: Your local Postgres connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/cetakin"

# JWT_SECRET: Secret for session encryption (required for login)
JWT_SECRET="any_random_string_here"

# SETUP_KEY: Used for initial admin creation at /api/auth/setup
SETUP_KEY="setup123"

# APP_URL: The URL where this applet is hosted.
# APP_URL="http://localhost:3000"
